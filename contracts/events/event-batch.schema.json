{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlowOps event batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "canonical-event.schema.json" }
    }
  }
}
