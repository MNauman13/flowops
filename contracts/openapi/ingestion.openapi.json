{
  "openapi": "3.1.1",
  "info": {
    "title": "FlowOps ingestion API",
    "version": "0.1.0",
    "description": "Draft contract for live producers sending canonical purchase-to-payment events."
  },
  "paths": {
    "/api/v1/tenants/{tenantId}/workspaces/{workspaceId}/sources/{sourceId}/events": {
      "post": {
        "operationId": "acceptEventBatch",
        "summary": "Accept a batch of source events",
        "description": "Accepts up to 1000 canonical events and at most 10 MiB of JSON in a LIVE workspace. The batch is atomic. Identical previously accepted events reuse their event IDs. The producer token must be scoped to this source.",
        "security": [{ "ProducerToken": [] }],
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": { "$ref": "#/components/schemas/Identifier" }
          },
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": { "$ref": "#/components/schemas/Identifier" }
          },
          {
            "name": "sourceId",
            "in": "path",
            "required": true,
            "schema": { "$ref": "#/components/schemas/Identifier" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Reuse the same key for retries of the same request. Reusing the key with a changed request returns 409.",
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "../events/event-batch.schema.json" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The batch is durably accepted. Case processing is asynchronous.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AcceptanceReceipt" },
                "example": {
                  "receiptId": "76388377-9976-48b7-98bb-17bb3e78f333",
                  "acceptedAt": "2026-11-26T10:15:01Z",
                  "newCount": 1,
                  "duplicateCount": 0,
                  "eventIds": ["00000000-0000-0000-0000-000000000004"]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ProducerToken": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "Identifier": { "type": "string", "format": "uuid" },
      "AcceptanceReceipt": {
        "type": "object",
        "required": ["receiptId", "acceptedAt", "newCount", "duplicateCount", "eventIds"],
        "properties": {
          "receiptId": { "$ref": "#/components/schemas/Identifier" },
          "acceptedAt": { "type": "string", "format": "date-time" },
          "newCount": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "duplicateCount": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "eventIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": { "$ref": "#/components/schemas/Identifier" },
            "description": "One event ID per submitted event, in request order. A previously accepted event keeps its original ID."
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status", "code", "detail", "instance", "correlationId", "fieldErrors"],
        "properties": {
          "type": { "type": "string", "format": "uri-reference" },
          "title": { "type": "string" },
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "code": { "type": "string" },
          "detail": { "type": "string" },
          "instance": { "type": "string", "format": "uri-reference" },
          "correlationId": { "type": "string" },
          "fieldErrors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "message"],
              "properties": {
                "field": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request contains malformed JSON or lacks the required idempotency key.",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Unauthenticated": {
        "description": "Producer authentication is missing or invalid.",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Forbidden": {
        "description": "The authenticated principal lacks permission for the operation on a visible resource.",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "NotFound": {
        "description": "The target source or workspace is missing or outside the caller's scope.",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Conflict": {
        "description": "EVENT_IDENTITY_CONFLICT, IDEMPOTENCY_CONFLICT or WORKSPACE_MODE_CONFLICT. The request creates no partially accepted batch.",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "PayloadTooLarge": {
        "description": "The request body or an individual event exceeds its size limit.",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "ValidationFailed": {
        "description": "The JSON is readable but violates the event contract or source mapping.",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "RateLimited": {
        "description": "The source rate limit or tenant backlog limit has been reached.",
        "headers": {
          "Retry-After": {
            "required": true,
            "schema": { "type": "integer", "minimum": 0 },
            "description": "Seconds to wait before retrying."
          }
        },
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Unavailable": {
        "description": "The service is temporarily unable to accept work.",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      }
    }
  }
}
